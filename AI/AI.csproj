<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Prompts\*.yml" />
    <ProjectReference Include="..\Domain\Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- MAF abstractions: IChatClient, IEmbeddingGenerator, ChatMessage, Embedding<T> -->
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.7.0" />
    <!-- MAF pipeline: .UseLogging(), .UseDistributedCache(), .UseFunctionInvocation() -->
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.7.0" />
    <!-- IDistributedCache, DistributedCacheEntryOptions -->
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.9" />
    <!-- IServiceCollection, ActivatorUtilities, AddKeyedSingleton -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <!-- IOptions<T>, IOptionsSnapshot<T>, Options.Create() -->
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.9" />
    <!-- ILogger<T> -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
  </ItemGroup>

</Project>
