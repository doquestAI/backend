<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Prompts\*.yml" />
    <ProjectReference Include="..\Domain\Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft Agent Framework (MAF) — successor of Semantic Kernel + AutoGen, GA Apr/2026 -->
    <PackageReference Include="Microsoft.Agents.AI" Version="1.11.0" />
    <PackageReference Include="Microsoft.Agents.AI.Abstractions" Version="1.11.0" />

    <!-- Microsoft.Extensions.AI — abstractions transitively used by MAF (IChatClient, IEmbeddingGenerator) -->
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.7.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.7.0" />

    <!-- ModelContextProtocol — SDK oficial .NET para clientes MCP (StdIo, SSE) -->
    <PackageReference Include="ModelContextProtocol" Version="0.4.1-preview.1" />

    <!-- Plumbing -->
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
  </ItemGroup>

</Project>
